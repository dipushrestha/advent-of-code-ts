{
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": ["deno.ns", "dom", "esnext"]
  },
  "fmt": {
    "lineWidth": 80,
    "semiColons": true,
    "singleQuote": true
  },
  "tasks": {
    "check": "deno check src/**/*.ts scripts/**/*.ts",
    "test": "deno test --allow-read",
    "test:watch": "deno test --allow-read --watch",
    "scaffold": "deno run --allow-read --allow-write --allow-env --allow-net scripts/scaffold_day.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.15"
  }
}
